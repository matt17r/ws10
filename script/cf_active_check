#!/usr/bin/env ruby
# Exit codes:
#   0 — this host's Cloudflare tunnel is the current DNS target for ws10.run
#   1 — another host is definitively the current DNS target
#   2 — indeterminate (missing config, or the CF API can't be reached)
#
# Used by the backup gate: 1 self-demotes a recovered passive host; 2 must
# NOT demote, so a transient API blip never permanently disables backups.

require "net/http"
require "json"

# __dir__ resolves the Capistrano `current` symlink, so from a deployed
# release this script lives at <deploy_to>/releases/<timestamp>/script
# and shared/ is three levels up; from a plain checkout it is two.
SHARED_PATH = [
  File.expand_path("../../shared", __dir__),
  File.expand_path("../../../shared", __dir__)
].find { |path| Dir.exist?(path) } || File.expand_path("../../shared", __dir__)
ENV_FILE     = File.join(SHARED_PATH, "config", "cloudflare.env")
UUID_GLOB    = "/etc/cloudflared/*-tunnel-uuid"
HOSTNAME     = "ws10.run"

def parse_env_file(path)
  File.readlines(path, chomp: true).each_with_object({}) do |line, h|
    next if line.strip.empty? || line.start_with?("#")
    k, v = line.split("=", 2)
    h[k.strip] = v&.strip
  end
end

unless File.exist?(ENV_FILE)
  warn "#{ENV_FILE} not found — cannot determine active host"
  exit 2
end

env  = parse_env_file(ENV_FILE)
uuid = Dir.glob(UUID_GLOB).map { |f| File.read(f).strip }.first

unless uuid && !uuid.empty?
  warn "Tunnel UUID file not found at #{UUID_GLOB}"
  exit 2
end

my_target = "#{uuid}.cfargotunnel.com"

record_id = env["CF_DNS_RECORD_IDS"]
  &.split(",")
  &.find { |r| r.start_with?("#{HOSTNAME}:") }
  &.split(":", 2)
  &.last

unless record_id
  warn "No CF_DNS_RECORD_IDS entry for #{HOSTNAME}"
  exit 2
end

begin
  uri = URI("https://api.cloudflare.com/client/v4/zones/#{env["CF_ZONE_ID"]}/dns_records/#{record_id}")
  req = Net::HTTP::Get.new(uri)
  req["Authorization"] = "Bearer #{env["CF_API_TOKEN"]}"
  res  = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true, open_timeout: 5, read_timeout: 10) { |h| h.request(req) }
  data = JSON.parse(res.body)
  current_target = data.dig("result", "content")

  if current_target.nil?
    warn "CF API returned no record content (#{data["errors"]&.inspect}) — cannot determine active host"
    exit 2
  elsif current_target == my_target
    exit 0
  else
    warn "CF origin is #{current_target}, this host is #{my_target}"
    exit 1
  end
rescue => e
  warn "CF API check failed: #{e.message} — cannot determine active host"
  exit 2
end
