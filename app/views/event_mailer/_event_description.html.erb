<% if event.description.present? %>
<tr>
    <td style="padding: 0 20px 20px 20px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
                <td style="padding: 16px 20px; background-color: #f9f5f6; border-left: 4px solid #DB2955; font-family: sans-serif; font-size: 16px; line-height: 24px; color: #54494B; font-style: italic;">
                    <%= event.description %>
                </td>
            </tr>
        </table>
    </td>
</tr>
<% end %>
