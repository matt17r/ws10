<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title><%= "Thank you for volunteering at WS10 ##{@event.number} at #{@event.location}" %></title>

    <!--[if gte mso 9]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->

    <style>
        :root {
          color-scheme: light dark;
          supported-color-schemes: light dark;
        }
        html, body { margin: 0 auto !important; padding: 0 !important; height: 100% !important; width: 100% !important; }
        * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
        div[style*="margin: 16px 0"] { margin: 0 !important; }
        #MessageViewBody, #MessageWebViewDiv { width: 100% !important; }
        table, td { mso-table-lspace: 0pt !important; mso-table-rspace: 0pt !important; }
        table { border-spacing: 0 !important; border-collapse: collapse !important; table-layout: fixed !important; margin: 0 auto !important; }
        img { -ms-interpolation-mode:bicubic; }
        a { text-decoration: none; }
        a[x-apple-data-detectors], .unstyle-auto-detected-links a, .aBn { border-bottom: 0 !important; cursor: default !important; color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
        .a6S { display: none !important; opacity: 0.01 !important; }
        .im { color: inherit !important; }
        img.g-img + div { display: none !important; }
        @media only screen and (min-device-width: 320px) and (max-device-width: 374px) { u ~ div .email-container { min-width: 320px !important; } }
        @media only screen and (min-device-width: 375px) and (max-device-width: 413px) { u ~ div .email-container { min-width: 375px !important; } }
        @media only screen and (min-device-width: 414px) { u ~ div .email-container { min-width: 414px !important; } }
    </style>

    <style>
      .button-td, .button-a { transition: all 100ms ease-in; }
      .button-td-primary:hover, .button-a-primary:hover { background: #b21e43 !important; border-color: #b21e43 !important; }
      @media screen and (max-width: 600px) { .email-container p { font-size: 17px !important; } }
      @media (prefers-color-scheme: dark) {
        .email-bg { background: #111111 !important; }
        .darkmode-bg { background: #222222 !important; }
        h1, h2, h3, p, li, .darkmode-text, .email-container a:not([class]) { color: #F7F7F9 !important; }
        td.button-td-primary, td.button-td-primary a { background: #ffffff !important; border-color: #ffffff !important; color: #222222 !important; }
        td.button-td-primary:hover, td.button-td-primary a:hover { background: #cccccc !important; border-color: #cccccc !important; }
        .footer td { color: #aaaaaa !important; }
        .darkmode-fullbleed-bg { background-color: #0F3016 !important; }
      }
    </style>
</head>
<body width="100%" style="margin: 0; padding: 0 !important; mso-line-height-rule: exactly; background-color: #9DA39A;" class="email-bg">
  <center role="article" aria-roledescription="email" lang="en" style="width: 100%; background-color: #9DA39A;" class="email-bg">
    <!--[if mso | IE]><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #9DA39A;" class="email-bg"><tr><td><![endif]-->

        <div style="max-height:0; overflow:hidden; mso-hide:all;" aria-hidden="true">
            Thank you <%= @user.name %> for volunteering at WS10 <%= @event.location %> #<%= @event.number %> on <%= @event.date.strftime("%A, %-d %B %Y") %>. Your help makes these events possible!
        </div>
        <div style="display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all; font-family: sans-serif;">
          &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
        </div>

        <div style="max-width: 600px; margin: 0 auto;" class="email-container">
            <!--[if mso]><table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600"><tr><td><![endif]-->

          <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;">
              <tr>
                  <td style="padding: 20px 0; text-align: center">
                      <img src="https://ws10.run/icon.png" width="200" height="200" alt="WS10 logo in bright pink" border="0" style="height: auto; background: #ffffff; font-family: sans-serif; font-size: 15px; line-height: 15px; color: #555555; border-radius: 20px;">
                  </td>
              </tr>

                <tr>
                    <td style="background-color: #ffffff;" class="darkmode-bg">
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td style="padding: 20px; font-family: sans-serif; font-size: 18px; line-height: 24px; color: #555555;">
                                    <h1 style="margin: 0 0 10px 0; font-family: sans-serif; font-size: 40px; line-height: 45px; color: #54494B;">Thank you!</h1>
                                    <h2 style="margin: 0 0 10px 0; font-family: sans-serif; font-size: 30px; line-height: 35px; color: #54494B; font-weight: normal;">You volunteered at WS10 #<%= @event.number %></h2>
                                    <p style="margin: 0;">Thank you <%= @user.name %> for helping with <strong><%= @volunteer.role %></strong> at <%= @event.location %> this morning (<%= @event.date.strftime("%A, %-d %B %Y") %>). This was your <%= @volunteer_count.ordinalize %> time volunteering<% if @volunteer_count > 1 %> and your <%= @location_count.ordinalize %> time at <%= @event.location %><% end %>. I really appreciate your support keeping this event going.</p>
                                </td>
                            </tr>
                            <% if @newly_earned_badges.any? %>
                            <tr>
                                <td style="padding: 20px; font-family: sans-serif; font-size: 18px; line-height: 24px; color: #555555;">
                                    <h2 style="margin: 0 0 10px 0; font-family: sans-serif; font-size: 24px; line-height: 28px; color: #54494B;">New Badges!</h2>
                                    <p style="margin: 0 0 15px 0;">
                                        You've earned <%= @newly_earned_badges.size %> new <a href="<%= badges_url %>" style="color: #DB2955;"><%= "badge".pluralize(@newly_earned_badges.size) %></a>:
                                    </p>
                                    <% @newly_earned_badges.each do |user_badge| %>
                                        <div style="margin: 10px 0; padding: 15px; background: #f5f5f5; border-radius: 8px;">
                                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                                <tr>
                                                    <td style="width: 48px; vertical-align: top;">
                                                        <div style="width: 48px; height: 48px; background: #FDF4F7; border-radius: 50%; display: inline-block; text-align: center; line-height: 48px; border: 4px solid <%= badge_border_colour(user_badge.badge) %>;">
                                                            <img src="<%= badge_icon_url(user_badge.badge) %>" alt="" width="29" height="29" style="width: 29px; height: 29px; vertical-align: middle; display: inline-block;">
                                                        </div>
                                                    </td>
                                                    <td style="padding-left: 10px;">
                                                        <strong style="color: #54494B;"><%= user_badge.badge.name %></strong><br>
                                                        <span style="color: #555555; font-size: 16px;"><%= user_badge.badge.description %></span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    <% end %>
                                </td>
                            </tr>
                            <% end %>
                            <% if @is_first_timer %>
                            <tr>
                                <td style="padding: 20px; font-family: sans-serif;">
                                    <p style="margin: 0; padding: 15px; background: #FDF4F7; border-left: 4px solid #DB2955; color: #54494B;">
                                        <strong>🎯 Welcome!</strong> This was your first WS10 event. We're so glad you joined us!
                                    </p>
                                </td>
                            </tr>
                            <% end %>
                            <tr>
                                <td style="padding: 20px; font-family: sans-serif; font-size: 18px; line-height: 24px; color: #555555;">
                                    <h2 style="margin: 0 0 10px 0; font-family: sans-serif; font-size: 24px; line-height: 28px; color: #54494B;">
                                        Your WS10 Journey
                                    </h2>
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background: #f5f5f5; border-radius: 8px;">
                                        <tr>
                                            <td style="padding: 15px; text-align: center; border-right: 1px solid #e0e0e0;">
                                                <div style="font-size: 32px; font-weight: bold; color: #DB2955;"><%= @total_events %></div>
                                                <div style="font-size: 14px; color: #666;">Total Events</div>
                                            </td>
                                            <td style="padding: 15px; text-align: center; border-right: 1px solid #e0e0e0;">
                                                <div style="font-size: 32px; font-weight: bold; color: #DB2955;"><%= @total_runs %></div>
                                                <div style="font-size: 14px; color: #666;">Runs Completed</div>
                                            </td>
                                            <td style="padding: 15px; text-align: center;">
                                                <div style="font-size: 32px; font-weight: bold; color: #DB2955;"><%= @volunteer_count %></div>
                                                <div style="font-size: 14px; color: #666;">Volunteer Roles</div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 0 20px 20px 20px;">
                                    <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: auto;">
                                        <tr>
                                            <td class="button-td button-td-primary" style="border-radius: 4px; background: #DB2955;">
                                                <a class="button-a button-a-primary" href="<%= event_url(@event) %>" style="background: #DB2955; border: 1px solid #DB2955; font-family: sans-serif; font-size: 20px; line-height: 20px; text-decoration: none; padding: 13px 17px; color: #ffffff; display: block; border-radius: 4px;">View all results</a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <%= render "event_mailer/event_description", event: @event %>
                        </table>
                    </td>
                </tr>
            </table>

            <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;" class="footer">
                <tr>
                    <td style="padding: 20px; font-family: sans-serif; font-size: 12px; line-height: 15px; text-align: center; color: #ffffff;">
                        Western Sydney 10<br><span class="unstyle-auto-detected-links">16 Lloyd St, Blacktown NSW 2148, Australia</span>
                        <br><br>
                        You received this transactional email because you registered at <a href="https://ws10.run" style="color: #54494B;">ws10.run</a> and volunteered at an event. This is not a marketing email so there is no unsubscribe option.
                    </td>
                </tr>
            </table>

            <!--[if mso]></td></tr></table><![endif]-->
        </div>

        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #54494B;" class="darkmode-fullbleed-bg">
            <tr>
                <td>
                    <div align="center" style="max-width: 600px; margin: auto;" class="email-container">
                        <!--[if mso]><table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" align="center"><tr><td><![endif]-->
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td style="padding: 20px; text-align: left; font-family: sans-serif; font-size: 15px; line-height: 20px; color: #ffffff;">
                                    <p style="margin: 0;">Western Sydney 10 is a young event and we're still learning. If you've got any suggestions for how to improve the events, the website, or these emails, simply reply to this email to let me know!</p>
                                </td>
                            </tr>
                        </table>
                        <!--[if mso]></td></tr></table><![endif]-->
                    </div>
                </td>
            </tr>
        </table>

    <!--[if mso | IE]></td></tr></table><![endif]-->
    </center>
</body>
</html>
