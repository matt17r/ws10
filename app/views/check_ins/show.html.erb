<div class="my-16 px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Check in</h1>
        <% if @event %>
          <p class="text-xl text-gray-600">
            <%= link_to @event.location.name, course_path(@event.location), class: "hover:text-primary" %>
          </p>
          <p class="text-lg text-gray-500 mt-2">
            <%= "Event ##{@event.number} – #{l @event.date}" %>
          </p>
        <% end %>
      </div>

      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="text-center">
            <% if @event.nil? %>
              <h2 class="text-2xl font-semibold text-gray-900 mb-4">Check-in isn't open yet</h2>
              <% if @next_event %>
                <p class="text-gray-600">
                  The next event is #<%= @next_event.number %> at
                  <%= link_to @next_event.location.name, course_path(@next_event.location), class: "text-primary hover:text-primary-hover underline underline-offset-3 hover:no-underline" %>
                  on <%= @next_event.date.strftime("%A %-d %B") %>.
                  Check-in opens at <%= @next_event.check_in_opens_at.strftime("%-l:%M%P") %> on the day.
                </p>
              <% else %>
                <p class="text-gray-600">There's no upcoming event scheduled yet.</p>
              <% end %>
            <% elsif @check_in %>
              <% recorded_time = @check_in.recorded_time_string %>
              <div class="mb-8">
                <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-green-100 mb-4">
                  <svg class="w-16 h-16 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <% if @check_in.pending? %>
                  <h2 class="text-2xl font-semibold text-gray-900 mb-2">Waiting for approval</h2>
                  <p class="text-gray-600">Thanks for letting us know you ran. An organiser will approve your late check-in soon.</p>
                <% elsif recorded_time %>
                  <h2 class="text-2xl font-semibold text-gray-900 mb-2">All done!</h2>
                  <p class="text-gray-600">Thanks for running.</p>
                <% else %>
                  <h2 class="text-2xl font-semibold text-gray-900 mb-2">You're checked in</h2>
                  <p class="text-gray-600">Enjoy the run!</p>
                <% end %>
              </div>

              <div class="border-t border-gray-200 py-6">
                <% if recorded_time %>
                  <dl>
                    <dt class="text-lg font-medium text-gray-900">Your time</dt>
                    <dd class="mt-1 text-5xl font-semibold tracking-tight text-primary"><%= recorded_time %></dd>
                  </dl>
                  <details class="mt-4 group">
                    <summary class="inline-flex items-center gap-1 cursor-pointer list-none text-sm text-gray-500 hover:text-gray-700 underline underline-offset-3 hover:no-underline group-open:mb-4 [&::-webkit-details-marker]:hidden">
                      <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                      </svg>
                      Edit time
                    </summary>
                    <%= render "time_form", label: "Your corrected time", recorded_time: recorded_time %>
                  </details>
                <% else %>
                  <%= render "time_form", label: "Finished? Add your time", recorded_time: nil %>
                <% end %>
              </div>

              <div class="border-t border-gray-200 pt-6">
                <% if flash[:check_in_message].present? %>
                  <p class="mt-4 text-green-700 font-medium"><%= flash[:check_in_message] %></p>
                <% end %>
                <%= form_with url: check_in_friend_path, method: :post, class: "space-y-4" do |form| %>
                  <div class="max-w-48 mx-auto">
                    <%= form.label :barcode, "Check someone else in using their barcode:", class: "block text-lg font-medium text-gray-900" %>
                    <%= form.text_field :barcode,
                        placeholder: "A001234",
                        class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary text-2xl py-3 text-center uppercase tracking-wider",
                        pattern: "[Aa]?\\d{1,6}",
                        required: true,
                        autocomplete: "off" %>
                  </div>
                  <%= form.submit "Check them in", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary" %>
                <% end %>
              </div>
            <% else %>
              <% if @late %>
                <p class="text-gray-600 mb-6">
                  Check-in for this event closed at <%= @event.check_in_closes_at.strftime("%-l%P") %> on <%= @event.date.strftime("%A %-d %B") %>.
                  If you ran it, you can still submit a late check-in and an organiser will approve it.
                </p>
              <% end %>

              <%= form_with url: check_in_path, method: :post do |form| %>
                <%= form.button @late ? "Submit late check-in" : "Check in", class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary" %>
              <% end %>

              <% unless authenticated? %>
                <p class="mt-4 text-sm text-gray-500">
                  You'll be asked to sign in before checking in.
                  <%= link_to "Don't have an account? Sign up here", sign_up_path, class: "text-primary hover:text-primary-hover" %>
                </p>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
